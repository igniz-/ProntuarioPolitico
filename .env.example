# Azure OpenAI settings. Without these, the app uses its sample record.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=replace-me
AZURE_OPENAI_DEPLOYMENT=your-deployment-name

# Optional: use Turso in production. The default is a local SQLite file.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=replace-me

# Cache lifetime in hours. Defaults to 24 when unset or invalid.
CACHE_TTL_HOURS=24
